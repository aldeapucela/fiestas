{% extends "layout.njk" %}

{% block bodyClass %}fiestas-page fiestas-popular-page{% endblock %}
{% block footerClass %} site-footer--fiestas{% endblock %}

{% block body %}
<main class="fiestas-app fiestas-plan-app fiestas-popular-app" data-fiestas-app data-fiestas-popular-page data-community-plans-href="/planes/">
  <section class="fiestas-plan-screen fiestas-popular-screen">
    <header class="fiestas-plan-page-head">
      <div class="fiestas-plan-topbar">
        <a class="fiestas-plan-logo" href="/" aria-label="Volver a la agenda">
          <img src="/assets/favicon-128.png" alt="" />
        </a>
        <h1 id="fiestas-popular-title">Actividades populares</h1>
        <button
          class="fiestas-plan-header-share"
          type="button"
          data-fiestas-share-site
          data-share-title="Actividades populares | Fiestas Valladolid 2026"
          data-share-text="Mira las actividades más guardadas de las Fiestas Valladolid 2026"
          data-share-url="https://fiestas.aldeapucela.org/populares/"
          aria-label="Compartir actividades populares"
          title="Compartir actividades populares"
        >
          <i class="fa-solid fa-share-nodes" aria-hidden="true"></i>
        </button>
      </div>
    </header>

    <section class="fiestas-popular-intro" aria-labelledby="fiestas-popular-title">
      <p data-fiestas-popular-intro>Estas son las actividades más guardadas por los vecinos y vecinas</p>
      <p class="fiestas-share-feedback" data-fiestas-share-feedback role="status" aria-live="polite" hidden></p>
    </section>

    <div class="fiestas-popular-tabs" data-fiestas-popular-tabs role="tablist" aria-label="Ranking de actividades">
      <button
        class="fiestas-popular-tab is-active"
        type="button"
        role="tab"
        id="fiestas-popular-tab-saves"
        aria-controls="fiestas-popular-list"
        aria-selected="true"
        data-fiestas-popular-mode="saves"
      >
        <i class="fa-solid fa-bookmark" aria-hidden="true"></i>
        <span>Por guardados</span>
      </button>
      <button
        class="fiestas-popular-tab"
        type="button"
        role="tab"
        id="fiestas-popular-tab-visits"
        aria-controls="fiestas-popular-list"
        aria-selected="false"
        tabindex="-1"
        data-fiestas-popular-mode="visits"
      >
        <i class="fa-solid fa-eye" aria-hidden="true"></i>
        <span>Por visitas</span>
      </button>
    </div>

    <section class="fiestas-popular-list" data-fiestas-agenda data-fiestas-popular-list aria-labelledby="fiestas-popular-tab-saves" aria-live="polite" aria-busy="true">
      <div class="fiestas-popular-status" data-fiestas-popular-status>
        <i class="fa-solid fa-spinner" aria-hidden="true"></i>
        <span>Cargando actividades populares…</span>
      </div>
    </section>
  </section>
</main>

<nav class="fiestas-bottom-nav" aria-label="Navegación de fiestas">
  <a class="fiestas-bottom-link" href="/">
    <i class="fa-regular fa-calendar" aria-hidden="true"></i>
    <span>Agenda</span>
  </a>
  <a class="fiestas-bottom-link" href="/mapa/">
    <svg class="fiestas-bottom-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M12 21s7-5.1 7-11a7 7 0 1 0-14 0c0 5.9 7 11 7 11Z" />
      <circle cx="12" cy="10" r="2.35" />
    </svg>
    <span>Mapa</span>
  </a>
  <a class="fiestas-bottom-link" href="/plan/">
    <i class="fa-regular fa-heart" aria-hidden="true"></i>
    <span>Mi plan</span>
  </a>
  <a class="fiestas-bottom-link" href="/casetas/">
    <i class="fa-solid fa-store" aria-hidden="true"></i>
    <span>Casetas</span>
  </a>
  <button class="fiestas-bottom-link is-active" type="button" data-menu-open aria-label="Abrir más opciones">
    <i class="fa-solid fa-ellipsis" aria-hidden="true"></i>
    <span>Más</span>
  </button>
</nav>

{% include "partials/event-options.njk" %}
{% include "partials/plan-selector.njk" %}
{% include "partials/menu-drawer.njk" %}
{% include "partials/subscribe-modal.njk" %}
{% endblock %}
