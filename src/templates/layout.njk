<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="{{ meta.description or 'Agenda de las Fiestas de Valladolid 2026' }}" />
    <meta name="theme-color" content="#0f9f8d" />
    <meta name="application-name" content="Fiestas Valladolid" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Fiestas Valladolid" />
    <title>{{ title or 'Fiestas Valladolid 2026 | Aldea Pucela' }}</title>
    <link rel="icon" type="image/png" href="/assets/favicon.png" />
    <link rel="manifest" href="/assets/manifest.webmanifest" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/icons/apple-touch-icon.png" />
    {# Integraciones externas aprobadas de Aldea Pucela Eventos. #}
    <link rel="alternate" type="application/rss+xml" title="Aldea Pucela Eventos RSS" href="https://eventos.aldeapucela.org/rss.xml" />
    <link rel="alternate" type="text/calendar" title="Aldea Pucela Eventos Calendario" href="https://eventos.aldeapucela.org/calendar.ics" />
    {% if canonicalUrl %}<link rel="canonical" href="{{ canonicalUrl }}" />{% endif %}
    {% if robotsMeta %}<meta name="robots" content="{{ robotsMeta }}" />{% endif %}
    {% if structuredData %}<script type="application/ld+json">{{ structuredData | dump | safe }}</script>{% endif %}
    {% if social %}
    <meta property="og:type" content="{{ social.type or 'website' }}" />
    <meta property="og:site_name" content="Aldea Pucela" />
    <meta property="og:title" content="{{ social.title or title or 'Fiestas Valladolid 2026 | Aldea Pucela' }}" />
    <meta property="og:description" content="{{ social.description or meta.description or 'Agenda de las Fiestas de Valladolid 2026' }}" />
    {% if social.image %}
    <meta property="og:image" content="{{ social.image }}" />
    <meta property="og:image:secure_url" content="{{ social.image }}" />
    <meta property="og:image:width" content="{{ social.imageWidth or 1200 }}" />
    <meta property="og:image:height" content="{{ social.imageHeight or 630 }}" />
    <meta property="og:image:type" content="{{ social.imageType or 'image/jpeg' }}" />
    <meta property="og:image:alt" content="{{ social.imageAlt or social.title or title }}" />
    {% endif %}
    {% if social.url %}<meta property="og:url" content="{{ social.url }}" />{% endif %}
    <meta name="twitter:card" content="{{ social.card or 'summary_large_image' }}" />
    <meta name="twitter:title" content="{{ social.title or title or 'Fiestas Valladolid 2026 | Aldea Pucela' }}" />
    <meta name="twitter:description" content="{{ social.description or meta.description or 'Agenda de las Fiestas de Valladolid 2026' }}" />
    {% if social.image %}
    <meta name="twitter:image" content="{{ social.image }}" />
    <meta name="twitter:image:alt" content="{{ social.imageAlt or social.title or title }}" />
    {% endif %}
    {% endif %}
    {% block extraHead %}{% endblock %}
    <script>
      window.__FIESTAS_ANALYTICS_CONFIG__ = {{ analyticsConfig | dump | safe }};
    </script>
    <script>
      (function () {
        const key = 'aldeapucela_theme';
        try {
          const saved = window.localStorage.getItem(key);
          const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme = saved === 'dark' || saved === 'light' ? saved : (prefersDark ? 'dark' : 'light');
          if (theme === 'dark') document.documentElement.classList.add('dark');
          document.documentElement.style.colorScheme = theme;
        } catch (_) {}
      }());
    </script>
    <link rel="stylesheet" href="/assets/css/{{ pageCss }}" />
    {# Se mantiene remoto para aprovechar la caché compartida con eventos.aldeapucela.org. #}
    <link rel="stylesheet" href="https://eventos.aldeapucela.org/assets/fontawesome/css/all.min.css" />
  </head>
  <body class="{% block bodyClass %}{% endblock %}">
    {% block header %}{% endblock %}
    {% block body %}{% endblock %}
    <footer class="site-footer{% block footerClass %}{% endblock %}">
      <div class="site-footer-inner">
        <p class="site-footer-copy">
          Licencia contenido
          <a href="https://creativecommons.org/licenses/by-sa/4.0/deed.es" target="_blank" rel="noopener noreferrer">CC BY-SA 4.0</a>
          · Código
          <a href="https://www.gnu.org/licenses/agpl-3.0.html" target="_blank" rel="noopener noreferrer">AGPL-3.0</a>
          · <a href="https://github.com/aldeapucela/fiestas" target="_blank" rel="noopener noreferrer">GitHub</a>
          · Proyecto creado por vecinos voluntarios de
          <a href="https://aldeapucela.org" target="_blank" rel="noopener noreferrer">Aldea Pucela</a>
        </p>
      </div>
    </footer>
    <button
      class="scroll-top-btn is-hidden"
      type="button"
      data-scroll-top
      aria-label="Volver arriba"
      title="Volver arriba"
      aria-hidden="true"
      tabindex="-1"
    >
      <i class="fa-solid fa-arrow-up" aria-hidden="true"></i>
    </button>
    <button
      class="fiestas-chatbot-launcher"
      type="button"
      data-fiestas-chatbot-open
      aria-controls="fiestas-chatbot-dialog"
      aria-haspopup="dialog"
      aria-label="Preguntar sobre las fiestas"
      title="Preguntar sobre las fiestas"
    >
      <span class="fiestas-chatbot-glyph" aria-hidden="true">
        <i class="fa-solid fa-robot"></i>
        <i class="fa-solid fa-comment-dots fiestas-chatbot-glyph-bubble"></i>
      </span>
    </button>
    <div class="fiestas-chatbot-dialog" id="fiestas-chatbot-dialog" data-fiestas-chatbot-dialog hidden>
      <section
        class="fiestas-chatbot-panel"
        role="dialog"
        aria-labelledby="fiestas-chatbot-title"
        aria-describedby="fiestas-chatbot-description"
      >
        <header class="fiestas-chatbot-header">
          <div class="fiestas-chatbot-heading">
            <span class="fiestas-chatbot-mark" aria-hidden="true">
              <span class="fiestas-chatbot-glyph">
                <i class="fa-solid fa-robot"></i>
                <i class="fa-solid fa-comment-dots fiestas-chatbot-glyph-bubble"></i>
              </span>
            </span>
            <div>
              <p class="fiestas-plan-kicker">ASISTENTE VIRTUAL</p>
              <h2 id="fiestas-chatbot-title">Preguntas sobre las fiestas</h2>
            </div>
          </div>
          <button class="fiestas-chatbot-close" type="button" data-fiestas-chatbot-close aria-label="Cerrar asistente">
            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
          </button>
        </header>
        <p class="sr-only" id="fiestas-chatbot-description">Pregunta por actividades y planes vecinales de las Fiestas Valladolid 2026.</p>
        <div class="fiestas-chatbot-form-view" data-fiestas-chatbot-form-view>
          <form class="fiestas-chatbot-form" data-fiestas-chatbot-form>
            <textarea
              id="fiestas-chatbot-question"
              class="fiestas-chatbot-question"
              data-fiestas-chatbot-question
              aria-labelledby="fiestas-chatbot-title"
              rows="4"
              maxlength="500"
              placeholder="¿Qué plan me recomiendas si voy con niños y quiero actividades gratuitas?"
              required
            ></textarea>
            <button class="fiestas-chatbot-submit" type="submit">
              <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
              <span>Enviar pregunta</span>
            </button>
            <p class="fiestas-chatbot-scope">Se enviará tu consulta a ChatGPT. Verifica la información: puede contener inexactitudes.</p>
          </form>
        </div>
      </section>
    </div>
    <script type="module" src="/assets/js/{{ pageJs }}?v={{ jsVersion }}" defer></script>
    {% block extraScripts %}{% endblock %}
    <script type="module" src="/assets/js/scroll-top.{{ jsVersion }}.js" defer></script>
    <script type="module" src="/assets/js/pwa.{{ jsVersion }}.js" defer></script>
    <script type="module" src="/assets/js/chatbot.{{ jsVersion }}.js" defer></script>
  </body>
</html>
