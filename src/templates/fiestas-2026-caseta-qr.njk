<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {% set qrPageUrl = publicBaseUrl + caseta.urlPath + 'qr/' %}
    {% set qrSocialImage = publicBaseUrl + '/assets/social/casetas-feria-de-dia.jpg?v=' + assetVersion %}
    <meta name="description" content="Cartel QR de {{ caseta.name }} para descubrir y valorar las casetas de feria de día de Valladolid 2026." />
    <meta name="robots" content="noindex,follow" />
    <link rel="canonical" href="{{ qrPageUrl }}" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content="Cartel QR | {{ caseta.name }} | Casetas Feria de Día" />
    <meta property="og:description" content="Descubre y valora {{ caseta.name }} y las casetas de feria de día de Valladolid 2026." />
    <meta property="og:url" content="{{ qrPageUrl }}" />
    <meta property="og:image" content="{{ qrSocialImage }}" />
    <meta property="og:image:secure_url" content="{{ qrSocialImage }}" />
    <meta property="og:image:width" content="1731" />
    <meta property="og:image:height" content="909" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content="Casetas feria de día | Fiestas Valladolid 2026" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Cartel QR | {{ caseta.name }} | Casetas Feria de Día" />
    <meta name="twitter:description" content="Descubre y valora {{ caseta.name }} y las casetas de feria de día de Valladolid 2026." />
    <meta name="twitter:image" content="{{ qrSocialImage }}" />
    <meta name="twitter:image:alt" content="Casetas feria de día | Fiestas Valladolid 2026" />
    <title>Cartel QR | {{ caseta.name }} | Casetas Feria de Día</title>
    <style>
      html, body { margin: 0; min-height: 100%; background: #fffdf5; }
      body { display: flex; justify-content: center; }
      main { display: flex; width: min(100vw, 1200px); flex-direction: column; align-items: center; }
      img { display: block; width: min(100vw, 1200px); height: auto; }
      a { display: inline-flex; order: 2; align-items: center; gap: .5rem; margin: 1rem 0 1.5rem; padding: .75rem 1rem; border: 1px solid #0f9f8d; border-radius: .6rem; color: #087569; font: 700 1rem/1.2 system-ui, sans-serif; text-decoration: none; }
      a:hover, a:focus-visible { background: #eef9f7; }
    </style>
  </head>
  <body>
    <main>
      <img src="/assets/qr/casetas/{{ caseta.id }}.png?v={{ assetVersion }}" alt="Cartel para descubrir y valorar las casetas de feria de día" />
      <a
        href="/assets/qr/casetas/{{ caseta.id }}.png?v={{ assetVersion }}"
        download="casetas-{{ caseta.slug }}-qr.png"
        data-fiestas-caseta-qr-download
        data-caseta-id="{{ caseta.id }}"
      >
        <span aria-hidden="true">⇩</span>
        <span>Descargar imagen</span>
      </a>
    </main>
    <script type="module" src="/scripts/fiestas-2026.js"></script>
  </body>
</html>
