<div class="fiestas-event-options" data-fiestas-event-options hidden>
  <button class="fiestas-event-options-backdrop" type="button" data-event-options-close aria-label="Cerrar opciones"></button>
  <section class="fiestas-event-options-panel" role="dialog" aria-modal="true" aria-labelledby="event-options-title">
    <div class="fiestas-event-options-head">
      <div>
        <p class="fiestas-plan-kicker">ACTIVIDAD</p>
        <h2 id="event-options-title">Más opciones</h2>
      </div>
      <button class="fiestas-event-options-close" type="button" data-event-options-close aria-label="Cerrar">
        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
      </button>
    </div>
    <button class="fiestas-event-option" type="button" data-event-option-plan>
      <i class="fa-solid fa-list-check" aria-hidden="true"></i>
      <span>Añadir a un plan</span>
    </button>
  </section>
</div>
