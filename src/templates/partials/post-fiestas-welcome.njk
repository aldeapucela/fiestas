<div
  class="post-fiestas-welcome"
  data-fiestas-post-fiestas-welcome
  data-fiestas-post-fiestas-start="2026-09-14"
  hidden
>
  <button
    class="post-fiestas-welcome-backdrop"
    type="button"
    data-fiestas-post-fiestas-welcome-backdrop
    aria-label="Cerrar mensaje"
  ></button>
  <section
    class="post-fiestas-welcome-panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="post-fiestas-welcome-title"
    aria-describedby="post-fiestas-welcome-description"
  >
    <button
      class="post-fiestas-welcome-close"
      type="button"
      data-fiestas-post-fiestas-welcome-close
      aria-label="Cerrar mensaje"
    >
      <i class="fa-solid fa-xmark" aria-hidden="true"></i>
    </button>

    <div class="post-fiestas-welcome-heading">
      <img class="post-fiestas-welcome-logo" src="/assets/favicon-128.png" alt="" aria-hidden="true" />
      <div>
        <p class="post-fiestas-welcome-kicker">ALDEA PUCELA</p>
        <h2 id="post-fiestas-welcome-title">Gracias por acompañarnos</h2>
      </div>
    </div>

    <p class="post-fiestas-welcome-description" id="post-fiestas-welcome-description">
      Gracias por haber usado esta web. Más de 130.000 visitas han disfrutado de una agenda creada por vecinos y vecinas de forma voluntaria.
    </p>

    <p class="post-fiestas-welcome-transition">Pero esto no termina aquí</p>

    <div class="post-fiestas-welcome-actions" aria-label="Más propuestas de Aldea Pucela">
      <a
        class="post-fiestas-welcome-action post-fiestas-welcome-action-primary"
        href="https://eventos.aldeapucela.org/"
        target="_blank"
        rel="noopener noreferrer"
        data-fiestas-post-fiestas-welcome-link="eventos_culturales"
      >
        <i class="fa-solid fa-calendar-days" aria-hidden="true"></i>
        <span>
          <strong>Eventos culturales</strong>
          <small>Planes durante todo el año</small>
        </span>
      </a>
      <a
        class="post-fiestas-welcome-action"
        href="https://aldeapucela.org/boletin/"
        target="_blank"
        rel="noopener noreferrer"
        data-fiestas-post-fiestas-welcome-link="resumen_semanal"
      >
        <i class="fa-regular fa-envelope" aria-hidden="true"></i>
        <span>
          <strong>Resumen semanal</strong>
          <small>Nuevas propuestas por email</small>
        </span>
      </a>
    </div>

    <div class="post-fiestas-welcome-community-links" aria-label="Sigue en contacto con Aldea Pucela">
      <a
        href="https://t.me/aldeapucela/59137"
        target="_blank"
        rel="noopener noreferrer"
      >
        <i class="fa-brands fa-telegram" aria-hidden="true"></i>
        <span>Grupo de chat</span>
      </a>
      <a
        href="https://aldeapucela.org/whatsapp"
        target="_blank"
        rel="noopener noreferrer"
      >
        <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
        <span>Canal de WhatsApp</span>
      </a>
    </div>

    <div class="post-fiestas-welcome-social-links" aria-label="Redes sociales">
      <a href="https://www.facebook.com/aldeapucela" target="_blank" rel="noopener noreferrer" aria-label="Facebook" title="Facebook">
        <i class="fa-brands fa-facebook" aria-hidden="true"></i>
        <span>Facebook</span>
      </a>
      <a href="https://www.instagram.com/aldeapucela" target="_blank" rel="noopener noreferrer" aria-label="Instagram" title="Instagram">
        <i class="fa-brands fa-instagram" aria-hidden="true"></i>
        <span>Instagram</span>
      </a>
    </div>
  </section>
</div>
