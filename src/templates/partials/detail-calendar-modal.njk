<div class="calendar-modal" data-fiestas-detail-calendar-modal hidden>
  <button class="calendar-modal-backdrop" type="button" data-fiestas-detail-calendar-close aria-label="Cerrar diálogo"></button>
  <div
    class="calendar-modal-panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="fiestas-detail-calendar-title"
    aria-describedby="fiestas-detail-calendar-copy"
  >
    <div class="calendar-modal-header">
      <div>
        <h2 class="calendar-modal-title" id="fiestas-detail-calendar-title">Añadir al calendario</h2>
        <p class="calendar-modal-copy" id="fiestas-detail-calendar-copy">Elige dónde guardarlo.</p>
      </div>
      <button class="calendar-modal-close" type="button" data-fiestas-detail-calendar-close aria-label="Cerrar">
        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
      </button>
    </div>
    <div class="calendar-modal-actions">
      <a class="calendar-modal-action calendar-modal-action-primary" href="#" data-fiestas-detail-calendar-ics download>
        <i class="fa-solid fa-download" aria-hidden="true"></i>
        <span>Descargar ICS</span>
      </a>
      <a class="calendar-modal-action" href="#" data-fiestas-detail-calendar-google target="_blank" rel="noopener noreferrer">
        <i class="fa-brands fa-google" aria-hidden="true"></i>
        <span>Google Calendar</span>
      </a>
      <a class="calendar-modal-action" href="#" data-fiestas-detail-calendar-apple target="_blank" rel="noopener noreferrer" download>
        <i class="fa-brands fa-apple" aria-hidden="true"></i>
        <span>Apple Calendar</span>
      </a>
      <a class="calendar-modal-action" href="#" data-fiestas-detail-calendar-outlook target="_blank" rel="noopener noreferrer">
        <i class="fa-brands fa-microsoft" aria-hidden="true"></i>
        <span>Outlook</span>
      </a>
    </div>
  </div>
</div>
