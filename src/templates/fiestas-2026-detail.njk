{% extends "layout.njk" %}

{% block bodyClass %}fiestas-page page-event-detail fiestas-detail-page{% endblock %}
{% block footerClass %} site-footer--event-detail{% endblock %}

{% block extraHead %}
{% if event.coordinates %}
<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
  crossorigin=""
/>
{% endif %}
{% endblock %}

{% block body %}
<main
  class="fiestas-app fiestas-detail-app"
  data-fiestas-detail
  data-event-id="{{ event.id }}"
  data-event-date="{{ event.date }}"
  data-event-date-label="{{ event.dateLabel }}"
  data-event-start-time="{{ event.startTime }}"
  data-event-end-time="{{ event.endTime }}"
  data-event-title="{{ event.title }}"
  data-event-location="{{ event.location or event.zone or event.neighborhood }}"
  data-event-description="{{ event.description }}"
  data-event-summary="{{ event.summary }}"
  data-event-url="{{ event.canonicalUrl }}"
  {% if event.coordinates %}
  data-event-lat="{{ event.coordinates.lat }}"
  data-event-lng="{{ event.coordinates.lng }}"
  {% endif %}
  data-share-title="{{ event.title }}"
  data-share-text="{{ event.shareText }}"
  data-share-url="{{ event.canonicalUrl }}"
>
  <article class="fiestas-detail">
    <header class="fiestas-detail-top">
      <button class="fiestas-detail-top-button" type="button" data-fiestas-back aria-label="Volver a la agenda">
        <i class="fiestas-detail-back-icon fa-solid fa-arrow-left" aria-hidden="true"></i>
      </button>
      <p>Detalle de actividad</p>
      <div class="fiestas-detail-top-actions">
        <button class="fiestas-detail-top-button" type="button" data-fiestas-detail-save aria-label="Guardar actividad" aria-pressed="false">
          <i class="fa-regular fa-bookmark" aria-hidden="true"></i>
        </button>
        <button class="fiestas-detail-top-button" type="button" data-fiestas-more-options data-event-id="{{ event.id }}" aria-label="Más opciones" aria-haspopup="dialog">
          <i class="fa-solid fa-ellipsis" aria-hidden="true"></i>
        </button>
        <button class="fiestas-detail-top-button" type="button" data-fiestas-share aria-label="Compartir actividad">
          <i class="fiestas-detail-share-icon fa-solid fa-share-nodes" aria-hidden="true"></i>
        </button>
      </div>
    </header>

    {% if event.image %}
    <figure class="fiestas-detail-hero">
      <button
        class="fiestas-detail-hero-button"
        type="button"
        data-fiestas-detail-image
        data-image-src="{{ event.image }}"
        data-image-alt="{{ event.title }}"
        aria-label="Ver imagen completa"
      >
        <img src="{{ event.image }}" alt="" loading="eager" />
      </button>
    </figure>
    <div class="detail-lightbox" data-fiestas-detail-lightbox role="dialog" aria-modal="true" aria-label="Imagen de {{ event.title }}" hidden>
      <button class="detail-lightbox-backdrop" type="button" data-fiestas-detail-lightbox-close aria-label="Cerrar imagen"></button>
      <div class="detail-lightbox-panel">
        <button class="detail-lightbox-close" type="button" data-fiestas-detail-lightbox-close aria-label="Cerrar imagen">
          <i class="fa-solid fa-xmark" aria-hidden="true"></i>
        </button>
        <img class="detail-lightbox-image" data-fiestas-detail-lightbox-image src="{{ event.image }}" alt="{{ event.title }}" />
      </div>
    </div>
    {% endif %}

    <section class="fiestas-detail-title-block" aria-labelledby="event-title">
      <h1 id="event-title" class="fiestas-detail-title">{{ event.title }}</h1>
      <div class="fiestas-detail-tags" aria-label="Categorías">
        {% for tag in event.tags %}
        <a
          class="fiestas-detail-type fiestas-type-{{ tag | slugify }}"
          href="/?date=all&amp;type={{ tag | urlencode }}"
          aria-label="Ver todas las actividades de {{ tag }}"
        >
          <i class="fa-solid {% if loop.first %}{{ event.icon }}{% else %}fa-tag{% endif %} fiestas-type-{{ tag | slugify }}" aria-hidden="true"></i>
          {{ tag }}
        </a>
        {% endfor %}
      </div>
    </section>

    <section class="fiestas-detail-card fiestas-detail-facts" aria-label="Datos principales">
      <div class="fiestas-detail-fact">
        <i class="fa-regular fa-calendar" aria-hidden="true"></i>
        <span>{{ event.dateLabel }}{% if event.startTime %} · {{ event.startTime }}{% if event.endTime %} - {{ event.endTime }}{% endif %}{% else %} · Hora por confirmar{% endif %}</span>
      </div>
      <div class="fiestas-detail-fact">
        <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
        <span>{{ event.location or event.zone or event.neighborhood or 'Lugar por confirmar' }}</span>
      </div>
      <div class="fiestas-detail-fact">
        <i class="fa-solid fa-ticket" aria-hidden="true"></i>
        <span>
          {% if event.ticket and event.ticket.url %}
          <a class="fiestas-detail-fact-link" href="{{ event.ticket.url }}" target="_blank" rel="noopener noreferrer" data-fiestas-analytics-action="tickets">
            <span>{{ event.ticketLabel }}{% if event.ticketDetail %} · {{ event.ticketDetail }}{% endif %}</span>
            <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
          </a>
          {% else %}
          {{ event.ticketLabel }}{% if event.ticketDetail %} · {{ event.ticketDetail }}{% endif %}
          {% endif %}
        </span>
      </div>
    </section>

    <section class="fiestas-detail-map-card" aria-labelledby="event-map-title">
      <h2 id="event-map-title" class="sr-only">Ubicación</h2>
      {% if event.coordinates %}
      <div
        class="fiestas-detail-map"
        data-fiestas-detail-map
        data-lat="{{ event.coordinates.lat }}"
        data-lng="{{ event.coordinates.lng }}"
        data-title="{{ event.location or event.title }}"
      ></div>
      <div class="fiestas-detail-map-error" data-fiestas-detail-map-error hidden role="status"></div>
      {% else %}
      <div class="fiestas-detail-map-empty">
        <i class="fa-solid fa-map-location-dot" aria-hidden="true"></i>
        <p>Ubicación en mapa no disponible.</p>
        <span>{{ event.location or 'Lugar por confirmar' }}</span>
      </div>
      {% endif %}
      <div class="fiestas-detail-map-actions">
        <a class="fiestas-detail-map-action" href="{{ event.mapUrl }}">
          <i class="fa-regular fa-map" aria-hidden="true"></i>
          <span>Ver en el mapa</span>
        </a>
        {% if event.directionsUrl %}
        <a
          class="fiestas-detail-map-action"
          href="{{ event.directionsUrl }}"
          target="_blank"
          rel="noopener noreferrer"
          data-fiestas-directions
          data-fiestas-analytics-action="directions"
          data-lat="{{ event.coordinates.lat }}"
          data-lng="{{ event.coordinates.lng }}"
          data-title="{{ event.location or event.title }}"
        >
          <i class="fiestas-detail-directions-icon fa-solid fa-route" aria-hidden="true"></i>
          <span>Cómo llegar</span>
        </a>
        {% elif event.osmUrl %}
        <a class="fiestas-detail-map-action" href="{{ event.osmUrl }}" target="_blank" rel="noopener noreferrer" data-fiestas-analytics-action="location">
          <i class="fiestas-detail-directions-icon fa-solid fa-location-arrow" aria-hidden="true"></i>
          <span>Abrir ubicación</span>
        </a>
        {% else %}
        <span class="fiestas-detail-map-action fiestas-detail-map-action-disabled">
          <i class="fiestas-detail-directions-icon fa-solid fa-route" aria-hidden="true"></i>
          <span>Cómo llegar</span>
        </span>
        {% endif %}
      </div>
    </section>

    <section class="fiestas-detail-card fiestas-detail-copy" aria-labelledby="event-description-title">
      <h2 id="event-description-title">
        <i class="fa-solid {{ event.icon }}" aria-hidden="true"></i>
        Descripción
      </h2>
      <p>{{ event.description or event.summary or 'No hay descripción ampliada para esta actividad.' }}</p>
    </section>

    <section class="fiestas-detail-card fiestas-detail-actions" aria-label="Acciones de actividad">
      <button class="fiestas-detail-action" type="button" data-fiestas-detail-action-save aria-label="Guardar actividad" aria-pressed="false">
        <i class="fa-regular fa-bookmark" aria-hidden="true"></i>
        <span>Guardar</span>
      </button>
      <button class="fiestas-detail-action" type="button" data-fiestas-detail-action-share aria-label="Compartir actividad">
        <i class="fa-solid fa-share-nodes" aria-hidden="true"></i>
        <span>Compartir</span>
      </button>
      <button class="fiestas-detail-action" type="button" data-fiestas-detail-action-calendar aria-label="Añadir actividad al calendario">
        <i class="fa-regular fa-calendar-plus" aria-hidden="true"></i>
        <span>Añadir a calendario</span>
      </button>
    </section>

    {% if event.performances.length or event.organizers.length or event.collaborators.length %}
    <section class="fiestas-detail-card fiestas-detail-lists" aria-label="Información adicional">
      {% if event.performances.length %}
      <div>
        <h2>Actuaciones</h2>
        <ul>{% for item in event.performances %}<li>{{ item }}</li>{% endfor %}</ul>
      </div>
      {% endif %}
      {% if event.organizers.length %}
      <div>
        <h2>Organiza</h2>
        <ul>{% for item in event.organizers %}<li>{{ item }}</li>{% endfor %}</ul>
      </div>
      {% endif %}
      {% if event.collaborators.length %}
      <div>
        <h2>Colabora</h2>
        <ul>{% for item in event.collaborators %}<li>{{ item }}</li>{% endfor %}</ul>
      </div>
      {% endif %}
    </section>
    {% endif %}

    <aside class="fiestas-community-card" aria-labelledby="fiestas-community-title">
      <div class="fiestas-community-heading">
        <img class="fiestas-community-logo" src="/assets/favicon.png" alt="" />
        <div>
          <p class="fiestas-community-kicker">ALDEA PUCELA</p>
          <h2 id="fiestas-community-title">Las fiestas también se viven en comunidad</h2>
        </div>
      </div>
      <p class="fiestas-community-copy">Recibe lo importante cada semana, comenta los planes con otros vecinos y sigue los avisos de las fiestas.</p>
      <a class="fiestas-community-primary" href="https://aldeapucela.org/boletin/" target="_blank" rel="noopener noreferrer">
        <i class="fa-regular fa-envelope" aria-hidden="true"></i>
        <span>Recibir el boletín semanal</span>
      </a>
      <div class="fiestas-community-secondary">
        <a class="fiestas-community-telegram" href="https://t.me/aldeapucela/59137" target="_blank" rel="noopener noreferrer">
          <i class="fa-brands fa-telegram" aria-hidden="true"></i>
          <span>Unirme al chat de fiestas</span>
        </a>
        <a class="fiestas-community-whatsapp" href="https://aldeapucela.org/whatsapp" target="_blank" rel="noopener noreferrer">
          <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
          <span>Canal de WhatsApp</span>
        </a>
        <a class="fiestas-community-facebook" href="https://www.facebook.com/aldeapucela" target="_blank" rel="noopener noreferrer">
          <i class="fa-brands fa-facebook" aria-hidden="true"></i>
          <span>Página en Facebook</span>
        </a>
      </div>
    </aside>

    {% if relatedEvents.length %}
    <section class="fiestas-detail-card fiestas-related-card" aria-labelledby="fiestas-related-title">
      <div class="fiestas-related-heading">
        <h2 id="fiestas-related-title">
          <i class="fa-solid {{ event.icon }} fiestas-type-{{ event.type | slugify }}" aria-hidden="true"></i>
          Relacionados
        </h2>
        <span>{{ event.type }}</span>
      </div>
      <div class="fiestas-related-list">
        {% for related in relatedEvents %}
        <a class="fiestas-related-item" href="{{ related.urlPath }}">
          <span class="fiestas-related-time">{{ related.startTime or '—' }}</span>
          <span class="fiestas-related-copy">
            <strong>{{ related.title }}</strong>
            <span>{{ related.dateLabel }}{% if related.location %} · {{ related.location }}{% endif %}</span>
          </span>
          <i class="fa-solid fa-chevron-right fiestas-related-arrow" aria-hidden="true"></i>
        </a>
        {% endfor %}
      </div>
      <a class="fiestas-related-more" href="/?date=all&amp;type={{ event.type | urlencode }}">
        <span>Ver más</span>
      </a>
    </section>
    {% endif %}

    {% if communityPlansForEvent.length %}
    <section class="fiestas-detail-card fiestas-detail-community-plans" aria-labelledby="fiestas-community-plans-title">
      <div class="fiestas-related-heading">
        <h2 id="fiestas-community-plans-title">
          <i class="fa-solid fa-people-group" aria-hidden="true"></i>
          {% if communityPlansForEvent.length == 1 %}Parte de este plan vecinal{% else %}Parte de estos planes vecinales{% endif %}
        </h2>
      </div>
      <div class="fiestas-detail-community-plans-track" aria-label="Planes vecinales que incluyen esta actividad">
        {% for plan in communityPlansForEvent %}
        <a class="fiestas-detail-community-plan" href="{{ plan.pageUrl }}" aria-label="Abrir el plan {{ plan.name }}, creado por {{ plan.author }}">
          <span class="fiestas-detail-community-plan-icon" aria-hidden="true">
            <i class="fa-solid {{ plan.iconClass }}"></i>
          </span>
          <span class="fiestas-detail-community-plan-copy">
            <strong>{{ plan.name }}</strong>
            <small>Por {{ plan.author }}</small>
          </span>
          <i class="fa-solid fa-chevron-right fiestas-detail-community-plan-arrow" aria-hidden="true"></i>
        </a>
        {% endfor %}
      </div>
      <a class="fiestas-related-more fiestas-detail-community-plans-more" href="/planes/">
        <span>Ver más</span>
      </a>
    </section>
    {% endif %}

    <div class="fiestas-detail-feedback" data-fiestas-detail-feedback aria-live="polite" hidden></div>
    <div class="fiestas-detail-copy-fallback" data-fiestas-share-fallback hidden>
      <label>
        <span>Enlace de la actividad</span>
        <input type="text" value="{{ event.canonicalUrl }}" readonly data-fiestas-share-url-input />
      </label>
      <button class="fiestas-detail-copy-button" type="button" data-fiestas-copy-share>Copiar enlace</button>
    </div>
  </article>

</main>

<nav class="fiestas-bottom-nav" aria-label="Navegación de fiestas">
  <a class="fiestas-bottom-link is-active" href="/">
    <i class="fa-regular fa-calendar" aria-hidden="true"></i>
    <span>Agenda</span>
  </a>
  <a class="fiestas-bottom-link" href="{{ event.mapUrl }}">
    <svg class="fiestas-bottom-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M12 21s7-5.1 7-11a7 7 0 1 0-14 0c0 5.9 7 11 7 11Z" />
      <circle cx="12" cy="10" r="2.35" />
    </svg>
    <span>Mapa</span>
  </a>
  <a class="fiestas-bottom-link" href="/plan/">
    <i class="fa-regular fa-heart" aria-hidden="true"></i>
    <span>Mi plan</span>
  </a>
  <a class="fiestas-bottom-link" href="/casetas/">
    <i class="fa-solid fa-store" aria-hidden="true"></i>
    <span>Casetas</span>
  </a>
  <button class="fiestas-bottom-link" type="button" data-menu-open aria-label="Abrir más opciones">
    <i class="fa-solid fa-ellipsis" aria-hidden="true"></i>
    <span>Más</span>
    <span class="fiestas-hint-dot" data-menu-hint-dot hidden aria-hidden="true"></span>
  </button>
</nav>

{% include "partials/event-options.njk" %}
{% include "partials/plan-selector.njk" %}
{% include "partials/menu-drawer.njk" %}
{% include "partials/subscribe-modal.njk" %}
{% endblock %}

{% block extraScripts %}
{% if event.coordinates %}
<script
  src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
  integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
  crossorigin=""
></script>
{% endif %}
{% endblock %}
