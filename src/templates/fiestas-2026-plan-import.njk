{% extends "layout.njk" %}

{% block bodyClass %}fiestas-page fiestas-plan-import-page{% endblock %}
{% block footerClass %} site-footer--fiestas{% endblock %}

{% block body %}
<main class="fiestas-app fiestas-plan-app" data-fiestas-plan-import>
  <section class="fiestas-plan-screen">
    <header class="fiestas-plan-page-head">
      <div class="fiestas-plan-topbar">
        <a class="fiestas-plan-logo" href="/plan/" aria-label="Volver a Mi plan">
          <img src="/assets/favicon-128.png" alt="" />
        </a>
        <h1 data-plan-import-title>Importar plan</h1>
        <span class="fiestas-plan-header-share" aria-hidden="true"></span>
      </div>
    </header>
    <a class="fiestas-plan-import-back" href="/plan/">
      <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
      <span>Volver a Mi plan</span>
    </a>

    <p class="fiestas-plan-import-status" data-plan-import-status role="status" hidden></p>

    <section class="fiestas-community-plan-detail fiestas-plan-import-shared-preview" data-plan-import-shared-preview hidden aria-live="polite">
      <div data-plan-import-shared-detail></div>
    </section>

    <section class="fiestas-plan-import-preview" data-plan-import-preview hidden aria-live="polite"></section>
    <div class="fiestas-plan-import-actions" data-plan-import-actions hidden>
      <button class="fiestas-plan-action fiestas-plan-import-cancel" type="button" data-plan-import-cancel>Cancelar</button>
      <button class="fiestas-plan-action fiestas-plan-action-primary fiestas-plan-import-confirm" type="button" data-plan-import-confirm hidden>Confirmar importación</button>
    </div>
    <div class="fiestas-plan-import-success" data-plan-import-success hidden>
      <a class="fiestas-plan-action fiestas-plan-action-primary fiestas-plan-import-view" data-plan-import-view href="/plan/" hidden>Ver plan importado</a>
    </div>
  </section>

</main>

<nav class="fiestas-bottom-nav" aria-label="Navegación de fiestas">
  <a class="fiestas-bottom-link" href="/">
    <i class="fa-regular fa-calendar" aria-hidden="true"></i>
    <span>Agenda</span>
  </a>
  <a class="fiestas-bottom-link" href="/mapa/">
    <svg class="fiestas-bottom-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M12 21s7-5.1 7-11a7 7 0 1 0-14 0c0 5.9 7 11 7 11Z" />
      <circle cx="12" cy="10" r="2.35" />
    </svg>
    <span>Mapa</span>
  </a>
  <a class="fiestas-bottom-link is-active" href="/plan/" aria-current="page">
    <i class="fa-regular fa-heart" aria-hidden="true"></i>
    <span>Mi plan</span>
  </a>
  <a class="fiestas-bottom-link" href="/casetas/">
    <i class="fa-solid fa-store" aria-hidden="true"></i>
    <span>Casetas</span>
  </a>
  <button class="fiestas-bottom-link" type="button" data-menu-open aria-label="Abrir más opciones">
    <i class="fa-solid fa-ellipsis" aria-hidden="true"></i>
    <span>Más</span>
    <span class="fiestas-hint-dot" data-menu-hint-dot hidden aria-hidden="true"></span>
  </button>
</nav>

{% include "partials/event-options.njk" %}
{% include "partials/plan-selector.njk" %}
{% include "partials/menu-drawer.njk" %}
{% include "partials/subscribe-modal.njk" %}
{% endblock %}
