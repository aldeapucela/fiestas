{% extends "layout.njk" %}

{% block bodyClass %}fiestas-page page-caseta-detail fiestas-detail-page{% endblock %}
{% block footerClass %} site-footer--fiestas{% endblock %}

{# Leaflet (CSS y JS) se carga bajo demanda desde ensureLeaflet() en initDetailMap(). #}
{% block extraHead %}
{% if caseta.coordinates %}
<link rel="preconnect" href="https://unpkg.com" crossorigin />
<link rel="preconnect" href="https://a.basemaps.cartocdn.com" />
{% endif %}
{% endblock %}

{% block body %}
<main
  class="fiestas-app fiestas-detail-app fiestas-caseta-detail-app"
  data-fiestas-detail
  data-caseta-detail="true"
  data-event-id="{{ caseta.id }}"
  data-event-title="{{ caseta.name }}"
  data-event-location="{{ caseta.location }}"
  data-event-description="Caseta de feria de día en Valladolid"
  data-event-summary="Caseta de feria de día en Valladolid"
  data-event-url="{{ caseta.canonicalUrl }}"
  data-share-title="{{ caseta.name }} | Casetas de Valladolid 2026"
  data-share-text="Descubre {{ caseta.name }}, una caseta de la feria de día de Valladolid 2026"
  data-share-url="{{ caseta.canonicalUrl }}"
  {% if caseta.coordinates %}
  data-event-lat="{{ caseta.coordinates.lat }}"
  data-event-lng="{{ caseta.coordinates.lng }}"
  {% endif %}
  style="--fiestas-type-color: {{ caseta.color }};"
>
  <article class="fiestas-detail fiestas-caseta-detail" data-caseta-id="{{ caseta.id }}">
    <header class="fiestas-detail-top">
      <a class="fiestas-detail-top-button" href="/casetas/" aria-label="Volver al mapa de casetas">
        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
      </a>
      <p>Detalle de caseta</p>
      <div class="fiestas-detail-top-actions">
        <button class="fiestas-detail-top-button fiestas-caseta-favorite-button" type="button" data-fiestas-caseta-favorite-toggle data-caseta-id="{{ caseta.id }}" aria-label="Añadir {{ caseta.name }} a favoritas" aria-pressed="false">
          <i class="fa-regular fa-star" aria-hidden="true"></i>
        </button>
        <button class="fiestas-detail-top-button" type="button" data-fiestas-share aria-label="Compartir caseta">
          <i class="fiestas-detail-share-icon fa-solid fa-share-nodes" aria-hidden="true"></i>
        </button>
      </div>
    </header>

    {% if caseta.image %}
    <figure class="fiestas-detail-hero">
      <button
        class="fiestas-detail-hero-button"
        type="button"
        data-fiestas-detail-image
        data-image-src="{{ caseta.image }}"
        data-image-alt="{{ caseta.imageAlt or caseta.name }}"
        aria-label="Ver foto de {{ caseta.name }} completa"
      >
        <img src="{{ caseta.image }}" alt="{{ caseta.imageAlt or caseta.name }}" loading="eager" />
      </button>
    </figure>
    <div class="detail-lightbox" data-fiestas-detail-lightbox role="dialog" aria-modal="true" aria-label="Imagen de {{ caseta.name }}" hidden>
      <button class="detail-lightbox-backdrop" type="button" data-fiestas-detail-lightbox-close aria-label="Cerrar imagen"></button>
      <div class="detail-lightbox-panel">
        <button class="detail-lightbox-close" type="button" data-fiestas-detail-lightbox-close aria-label="Cerrar imagen">
          <i class="fa-solid fa-xmark" aria-hidden="true"></i>
        </button>
        {# Sin src inicial: openLightbox() lo asigna desde data-image-src al abrir. #}
        <img class="detail-lightbox-image" data-fiestas-detail-lightbox-image alt="{{ caseta.imageAlt or caseta.name }}" />
      </div>
    </div>
    {% endif %}

    <section class="fiestas-detail-title-block" aria-labelledby="caseta-title">
      <h1 class="fiestas-detail-title" id="caseta-title">{{ caseta.name }}</h1>
      <div class="fiestas-detail-tags" aria-label="Clasificación de la caseta">
        <span class="fiestas-detail-type">
          <i class="fa-solid fa-store" aria-hidden="true"></i>
          {{ caseta.zone }}
        </span>
        <span class="fiestas-detail-type fiestas-caseta-type-muted">
          <i class="fa-solid fa-sun" aria-hidden="true"></i>
          Feria de día
        </span>
      </div>
    </section>

    <section class="fiestas-detail-card fiestas-detail-facts" aria-label="Datos principales">
      <div class="fiestas-detail-fact">
        <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
        <span>{{ caseta.location }}</span>
      </div>
      {% if caseta.placement %}
      <div class="fiestas-detail-fact">
        <i class="fa-solid fa-store" aria-hidden="true"></i>
        <span>{{ caseta.placement }}</span>
      </div>
      {% endif %}
    </section>

    <section class="fiestas-detail-map-card" aria-labelledby="caseta-map-title">
      <h2 id="caseta-map-title" class="sr-only">Ubicación</h2>
      {% if caseta.coordinates %}
      <div
        class="fiestas-detail-map"
        data-fiestas-detail-map
        data-lat="{{ caseta.coordinates.lat }}"
        data-lng="{{ caseta.coordinates.lng }}"
        data-title="{{ caseta.location }}"
      ></div>
      <div class="fiestas-detail-map-error" data-fiestas-detail-map-error hidden role="status"></div>
      {% else %}
      <div class="fiestas-detail-map-empty">
        <i class="fa-solid fa-map-location-dot" aria-hidden="true"></i>
        <p>Ubicación en mapa no disponible.</p>
        <span>{{ caseta.location }}</span>
      </div>
      {% endif %}
      {% if caseta.coordinates and caseta.coordinates.source == 'zone-fallback' %}
      <p class="fiestas-detail-map-note">
        <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
        Ubicación aproximada de la zona
      </p>
      {% endif %}
      <div class="fiestas-detail-map-actions">
        <a class="fiestas-detail-map-action" href="{{ caseta.mapUrl }}">
          <i class="fa-regular fa-map" aria-hidden="true"></i>
          <span>Ver en mapa</span>
        </a>
        {% if caseta.coordinates %}
        <button
          class="fiestas-detail-map-action"
          type="button"
          data-fiestas-directions-toggle
          data-fiestas-analytics-action="directions"
          aria-controls="caseta-directions-options-{{ caseta.id }}"
          aria-expanded="false"
        >
          <i class="fiestas-detail-directions-icon fa-solid fa-route" aria-hidden="true"></i>
          <span>Cómo llegar</span>
        </button>
        {% else %}
        <span class="fiestas-detail-map-action fiestas-detail-map-action-disabled">
          <i class="fiestas-detail-directions-icon fa-solid fa-route" aria-hidden="true"></i>
          <span>Cómo llegar</span>
        </span>
        {% endif %}
      </div>
      {% if caseta.coordinates %}
      <section
        class="fiestas-detail-directions-options"
        id="caseta-directions-options-{{ caseta.id }}"
        data-fiestas-directions-options
        aria-labelledby="caseta-directions-options-title-{{ caseta.id }}"
        hidden
      >
        <h3 id="caseta-directions-options-title-{{ caseta.id }}" class="sr-only">Opciones para llegar</h3>
        <div class="fiestas-detail-directions-grid">
          <a
            class="fiestas-detail-directions-option"
            href="https://vallabus.com/#/rutas?origen=fiestasaldea"
            target="_blank"
            rel="noopener noreferrer"
            data-fiestas-vallabus-route
            data-destination-name="{{ caseta.location }}"
            data-destination-lat="{{ caseta.coordinates.lat }}"
            data-destination-lon="{{ caseta.coordinates.lng }}"
          >
            <i class="fa-solid fa-bus" aria-hidden="true"></i>
            <span>Bus</span>
          </a>
          <a
            class="fiestas-detail-directions-option"
            href="https://vallabus.com/#/rutas?origen=fiestasaldea"
            target="_blank"
            rel="noopener noreferrer"
            data-fiestas-vallabus-route
            data-destination-name="{{ caseta.location }}"
            data-destination-lat="{{ caseta.coordinates.lat }}"
            data-destination-lon="{{ caseta.coordinates.lng }}"
            data-fiestas-vallabus-mode="bike"
          >
            <i class="fa-solid fa-bicycle" aria-hidden="true"></i>
            <span>Bici/BIKI</span>
          </a>
          <a
            class="fiestas-detail-directions-option"
            href="https://www.google.com/maps/dir/?api=1&amp;destination={{ caseta.coordinates.lat }},{{ caseta.coordinates.lng }}"
            target="_blank"
            rel="noopener noreferrer"
            data-fiestas-map-app
            data-fiestas-analytics-action="directions-app"
            data-lat="{{ caseta.coordinates.lat }}"
            data-lng="{{ caseta.coordinates.lng }}"
            data-title="{{ caseta.location }}"
          >
            <i class="fa-solid fa-map-location-dot" aria-hidden="true"></i>
            <span>Tu App</span>
          </a>
        </div>
      </section>
      {% endif %}
      {% if caseta.nearbyStops.length %}
      <section class="fiestas-detail-transit" data-fiestas-transit aria-labelledby="caseta-transit-title-{{ caseta.id }}">
        <script type="application/json" data-fiestas-transit-stops>{{ caseta.nearbyStops | dumpForScript | safe }}</script>
        <div class="fiestas-detail-transit-row">
          <h3 id="caseta-transit-title-{{ caseta.id }}" class="sr-only">Líneas de autobús cercanas</h3>
          <span class="fiestas-detail-transit-icon" aria-hidden="true"><i class="fa-solid fa-bus"></i></span>
          <button
            class="fiestas-detail-transit-scroll"
            type="button"
            data-fiestas-transit-scroll="prev"
            aria-label="Ver líneas anteriores"
            aria-controls="caseta-transit-lines-{{ caseta.id }}"
            hidden
          >
            <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
          </button>
          <div id="caseta-transit-lines-{{ caseta.id }}" class="fiestas-detail-transit-lines" data-fiestas-transit-lines role="group" aria-label="Líneas de autobús cercanas" tabindex="0">
            {% for line in caseta.nearbyLines %}
            <button
              class="fiestas-detail-transit-line"
              type="button"
              data-fiestas-transit-line="{{ line }}"
              aria-controls="caseta-transit-stops-{{ caseta.id }}"
              aria-expanded="false"
            >{{ line }}</button>
            {% endfor %}
          </div>
          <button
            class="fiestas-detail-transit-scroll"
            type="button"
            data-fiestas-transit-scroll="next"
            aria-label="Ver más líneas"
            aria-controls="caseta-transit-lines-{{ caseta.id }}"
            hidden
          >
            <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
          </button>
        </div>
        <div class="fiestas-detail-transit-details" id="caseta-transit-stops-{{ caseta.id }}" data-fiestas-transit-details hidden>
          <p class="fiestas-detail-transit-summary" data-fiestas-transit-summary></p>
          <ul class="fiestas-detail-transit-stop-list" data-fiestas-transit-stop-list></ul>
          <a
            class="fiestas-detail-transit-planner"
            href="https://vallabus.com/#/rutas?origen=fiestasaldea"
            target="_blank"
            rel="noopener noreferrer"
            data-fiestas-transit-planner
            data-fiestas-vallabus-route
            data-destination-name="{{ caseta.location }}"
            data-destination-lat="{{ caseta.coordinates.lat }}"
            data-destination-lon="{{ caseta.coordinates.lng }}"
          >
            <i class="fa-solid fa-route" aria-hidden="true"></i>
            <span>Planificar ruta en VallaBus</span>
          </a>
        </div>
      </section>
      {% endif %}
    </section>

    {% if caseta.details %}
    <section class="fiestas-caseta-menu fiestas-detail-card" aria-labelledby="caseta-menu-title">
      <div class="fiestas-caseta-menu-heading">
        <h2 id="caseta-menu-title"><i class="fa-solid fa-utensils" aria-hidden="true"></i> Carta</h2>
        <button
          class="fiestas-caseta-qr-button"
          type="button"
          data-fiestas-caseta-qr
          data-image-src="/assets/qr/casetas/{{ caseta.id }}.png?v={{ assetVersion }}"
          data-image-alt="Cartel QR de {{ caseta.name }}"
          aria-controls="caseta-qr-lightbox-{{ caseta.id }}"
          aria-haspopup="dialog"
          aria-label="Abrir QR de {{ caseta.name }}"
        >
          <i class="fa-solid fa-qrcode" aria-hidden="true"></i>
          <span>QR</span>
        </button>
      </div>
      <div class="detail-lightbox" id="caseta-qr-lightbox-{{ caseta.id }}" data-fiestas-caseta-qr-lightbox role="dialog" aria-modal="true" aria-label="Cartel QR de {{ caseta.name }}" hidden>
        <button class="detail-lightbox-backdrop" type="button" data-fiestas-caseta-qr-lightbox-close aria-label="Cerrar cartel QR"></button>
        <div class="detail-lightbox-panel">
          <button class="detail-lightbox-close" type="button" data-fiestas-caseta-qr-lightbox-close aria-label="Cerrar cartel QR">
            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
          </button>
          <img class="detail-lightbox-image" data-fiestas-caseta-qr-lightbox-image src="/assets/qr/casetas/{{ caseta.id }}.png?v={{ assetVersion }}" alt="Cartel QR de {{ caseta.name }}" />
          <a
            class="detail-lightbox-download"
            href="/assets/qr/casetas/{{ caseta.id }}.png?v={{ assetVersion }}"
            download="casetas-{{ caseta.slug }}-qr.png"
            data-fiestas-caseta-qr-download
            data-caseta-id="{{ caseta.id }}"
          >
            <i class="fa-solid fa-download" aria-hidden="true"></i>
            <span>Descargar imagen</span>
          </a>
        </div>
      </div>
      {% for section in caseta.details.menuSections %}
      <div class="fiestas-caseta-menu-section">
        <h3>{{ section.title }}</h3>
        <ul>
          {% for item in section.items %}
          {% set hasMenuMeta = item.description or item.price %}
          <li class="{% if hasMenuMeta %}fiestas-caseta-menu-item fiestas-caseta-menu-item--has-meta{% endif %}">
            {% if hasMenuMeta %}<details class="fiestas-caseta-menu-item-disclosure">{% endif %}
            {% if hasMenuMeta %}<summary class="fiestas-caseta-menu-item-main">{% else %}<div class="fiestas-caseta-menu-item-main">{% endif %}
              <span class="fiestas-caseta-menu-item-name">{{ item.name }}</span>
              {% if item.dietary == 'vegetarian' or item.dietary == 'vegan' or item.glutenFree %}
              <span class="fiestas-caseta-dietary-pills">
                {% if item.dietary == 'vegetarian' %}
                <span class="fiestas-caseta-dietary-pill fiestas-caseta-dietary-pill--vegetarian" role="img" aria-label="Vegetariano" title="Vegetariano"><i class="fa-solid fa-leaf" aria-hidden="true"></i></span>
                {% elif item.dietary == 'vegan' %}
                <span class="fiestas-caseta-dietary-pill fiestas-caseta-dietary-pill--vegan" role="img" aria-label="Vegano" title="Vegano"><i class="fa-solid fa-seedling" aria-hidden="true"></i></span>
                {% endif %}
                {% if item.glutenFree %}<span class="fiestas-caseta-dietary-pill fiestas-caseta-dietary-pill--gluten-free" role="img" aria-label="Sin gluten" title="Sin gluten"><img class="fiestas-caseta-dietary-icon-image" src="/assets/icons/dietary-gluten-free.png" alt="" aria-hidden="true" /></span>{% endif %}
              </span>
              {% endif %}
            {% if hasMenuMeta %}
            </summary>
            <div class="fiestas-caseta-menu-item-meta">
              {% if item.description %}<p class="fiestas-caseta-menu-item-description">{{ item.description }}</p>{% endif %}
              {% if item.price %}<span class="fiestas-caseta-menu-item-price">{{ item.price }}</span>{% endif %}
            </div>
            </details>
            {% else %}</div>{% endif %}
            {% if section.votable and item.id %}
            <button
              class="fiestas-caseta-dish-like"
              type="button"
              data-fiestas-caseta-dish-like
              data-caseta-id="{{ caseta.id }}"
              data-dish-id="{{ item.id }}"
              data-dish-name="{{ item.name }}"
              aria-pressed="false"
              aria-label="Me gusta {{ item.name }}"
              title="Me gusta {{ item.name }}"
            >
              <i class="fa-regular fa-thumbs-up" data-fiestas-caseta-dish-like-icon aria-hidden="true"></i>
              <span data-fiestas-caseta-dish-like-count hidden></span>
            </button>
            {% endif %}
          </li>
          {% endfor %}
        </ul>
      </div>
      {% endfor %}
      {% if caseta.details.highlights %}
      <div class="fiestas-caseta-highlights" aria-labelledby="caseta-specialties-title">
        <h3 id="caseta-specialties-title">Especialidades</h3>
        {% for highlight in caseta.details.highlights %}
        <p>{{ highlight }}</p>
        {% endfor %}
      </div>
      {% endif %}
      <div class="fiestas-caseta-dietary-legend" aria-label="Leyenda de los iconos de la carta">
        <span><i class="fa-solid fa-leaf fiestas-caseta-dietary-legend-icon fiestas-caseta-dietary-legend-icon--vegetarian" aria-hidden="true"></i>Vegetariano</span>
        <span><i class="fa-solid fa-seedling fiestas-caseta-dietary-legend-icon fiestas-caseta-dietary-legend-icon--vegan" aria-hidden="true"></i>Vegano</span>
        <span><img class="fiestas-caseta-dietary-legend-image" src="/assets/icons/dietary-gluten-free.png" alt="" aria-hidden="true" />Sin gluten</span>
      </div>
    </section>
    {% else %}
    <section class="fiestas-caseta-placeholder" aria-labelledby="caseta-placeholder-title">
      <i class="fa-solid fa-store" aria-hidden="true"></i>
      <div>
        <p class="fiestas-plan-kicker">PRÓXIMAMENTE</p>
        <h2 id="caseta-placeholder-title">Ficha de caseta</h2>
        <p class="fiestas-caseta-placeholder-copy">No tenemos información sobre la carta de esta caseta.</p>
        <ul class="fiestas-caseta-placeholder-list">
          <li>Puedes mandarnos una foto o el texto de sus pinchos y tapas al <a class="fiestas-caseta-placeholder-link" href="https://t.me/aldeapucela/59137" target="_blank" rel="noopener noreferrer">chat de fiestas</a>.</li>
          <li>Puedes avisar al dueño o a los trabajadores de la caseta para que nos lo manden ellos y podamos valorar sus pinchos y tapas.</li>
        </ul>
      </div>
    </section>
    {% endif %}

    <aside class="fiestas-community-card" aria-labelledby="fiestas-community-title">
      <div class="fiestas-community-heading">
        <img class="fiestas-community-logo" src="/assets/favicon-128.png" alt="" />
        <div>
          <p class="fiestas-community-kicker">ALDEA PUCELA</p>
          <h2 id="fiestas-community-title">Las fiestas también se viven en comunidad</h2>
        </div>
      </div>
      <p class="fiestas-community-copy">Descubre más planes de Valladolid, comparte tus favoritos y sigue los avisos de la feria de día.</p>
      <a class="fiestas-community-primary" href="https://aldeapucela.org/boletin/" target="_blank" rel="noopener noreferrer">
        <i class="fa-regular fa-envelope" aria-hidden="true"></i>
        <span>Recibir el boletín semanal</span>
      </a>
      <div class="fiestas-community-secondary">
        <a class="fiestas-community-telegram" href="https://t.me/aldeapucela/59137" target="_blank" rel="noopener noreferrer">
          <i class="fa-brands fa-telegram" aria-hidden="true"></i>
          <span>Unirme al chat de fiestas</span>
        </a>
        <a class="fiestas-community-whatsapp" href="https://aldeapucela.org/whatsapp" target="_blank" rel="noopener noreferrer">
          <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
          <span>Canal de WhatsApp</span>
        </a>
        <a class="fiestas-community-facebook" href="https://www.facebook.com/aldeapucela" target="_blank" rel="noopener noreferrer">
          <i class="fa-brands fa-facebook" aria-hidden="true"></i>
          <span>Página en Facebook</span>
        </a>
        <a class="fiestas-community-instagram" href="https://www.instagram.com/eventos.aldeapucela" target="_blank" rel="noopener noreferrer">
          <i class="fa-brands fa-instagram" aria-hidden="true"></i>
          <span>Instagram</span>
        </a>
      </div>
    </aside>

    {% if relatedCasetas.length %}
    <section class="fiestas-detail-card fiestas-related-card fiestas-caseta-related-card" aria-labelledby="fiestas-related-title">
      <div class="fiestas-related-heading">
        <h2 id="fiestas-related-title">
          <i class="fa-solid fa-store" aria-hidden="true"></i>
          Otras casetas en esta zona
        </h2>
        <span>{{ caseta.zone }}</span>
      </div>
      <div class="fiestas-related-list">
        {% for related in relatedCasetas %}
        <a class="fiestas-related-item" href="{{ related.urlPath }}">
          <span class="fiestas-caseta-related-icon" style="--fiestas-type-color: {{ related.color }};" aria-hidden="true">
            <i class="fa-solid fa-store"></i>
          </span>
          <span class="fiestas-related-copy">
            <strong>{{ related.name }}</strong>
            <span>{{ related.location }}{% if related.placement %} · {{ related.placement }}{% endif %}</span>
          </span>
          <i class="fa-solid fa-chevron-right fiestas-related-arrow" aria-hidden="true"></i>
        </a>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    <div class="fiestas-detail-feedback" data-fiestas-detail-feedback aria-live="polite" hidden></div>

    <a class="fiestas-caseta-back-link" href="/casetas/">
      <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
      <span>Volver a todas las casetas</span>
    </a>
  </article>
</main>

<nav class="fiestas-bottom-nav" aria-label="Navegación de fiestas">
  <a class="fiestas-bottom-link" href="/">
    <i class="fa-regular fa-calendar" aria-hidden="true"></i>
    <span>Agenda</span>
  </a>
  <a class="fiestas-bottom-link" href="{{ caseta.mapUrl }}">
    <svg class="fiestas-bottom-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M12 21s7-5.1 7-11a7 7 0 1 0-14 0c0 5.9 7 11 7 11Z" />
      <circle cx="12" cy="10" r="2.35" />
    </svg>
    <span>Mapa</span>
  </a>
  <a class="fiestas-bottom-link" href="/plan/">
    <i class="fa-regular fa-heart" aria-hidden="true"></i>
    <span>Mi plan</span>
  </a>
  <a class="fiestas-bottom-link is-active" href="/casetas/" aria-current="page">
    <i class="fa-solid fa-store" aria-hidden="true"></i>
    <span>Casetas</span>
  </a>
  <button class="fiestas-bottom-link" type="button" data-menu-open aria-label="Abrir más opciones">
    <i class="fa-solid fa-ellipsis" aria-hidden="true"></i>
    <span>Más</span>
    <span class="fiestas-hint-dot" data-menu-hint-dot hidden aria-hidden="true"></span>
  </button>
</nav>

{% include "partials/menu-drawer.njk" %}
{% include "partials/subscribe-modal.njk" %}
{% endblock %}

