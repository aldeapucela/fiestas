{% extends "layout.njk" %}

{% block bodyClass %}fiestas-page fiestas-plan-page{% endblock %}
{% block footerClass %} site-footer--fiestas{% endblock %}

{% block body %}
<main class="fiestas-app fiestas-plan-app" data-fiestas-plans-page data-plan-import-url="{{ publicBaseUrl }}/plan/importar/">
  <script>
    window.__FIESTAS_2026_EVENTS__ = {{ fiestasEventsJson | safe }};
  </script>
  <section class="fiestas-plan-screen">
    <header class="fiestas-plan-page-head">
      <div class="fiestas-plan-topbar">
        <a class="fiestas-plan-logo" href="/" aria-label="Volver a la agenda">
          <img src="/assets/favicon.png" alt="" />
        </a>
        <h1>Mi plan</h1>
        <div class="fiestas-plan-header-actions">
          <button class="fiestas-plan-header-manage" type="button" data-plan-manage-menu-trigger aria-haspopup="menu" aria-expanded="false" aria-controls="plan-manage-menu" aria-label="Más opciones del plan" hidden>
            <i class="fa-solid fa-ellipsis" aria-hidden="true"></i>
          </button>
          <button class="fiestas-plan-header-share" type="button" data-plan-header-share aria-label="Compartir mi plan">
            <i class="fa-solid fa-arrow-up-from-bracket" aria-hidden="true"></i>
          </button>
          <div class="fiestas-plan-manage-menu" id="plan-manage-menu" data-plan-manage-menu role="menu" hidden>
            <button type="button" role="menuitem" data-plan-manage-action="calendar">
              <i class="fa-solid fa-calendar-plus" aria-hidden="true"></i>
              <span>Añadir al calendario</span>
            </button>
            <button type="button" role="menuitem" data-plan-manage-action="edit">
              <i class="fa-solid fa-pen" aria-hidden="true"></i>
              <span>Editar</span>
            </button>
            <button type="button" role="menuitem" data-plan-manage-action="delete" class="is-danger">
              <i class="fa-solid fa-trash" aria-hidden="true"></i>
              <span>Eliminar</span>
            </button>
          </div>
        </div>
      </div>
      <div class="fiestas-plan-tools">
        <div class="fiestas-plan-picker" data-plan-picker>
          <button class="fiestas-plan-picker-trigger" type="button" data-plan-picker-trigger aria-haspopup="listbox" aria-expanded="false" aria-controls="plan-picker-menu">
          <i class="fa-solid fa-star" data-plan-picker-icon aria-hidden="true"></i>
          <span class="fiestas-plan-picker-label" data-plan-picker-label>Guardados</span>
          <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
          </button>
          <div class="fiestas-plan-picker-menu" id="plan-picker-menu" data-plan-picker-menu role="listbox" aria-label="Seleccionar plan" hidden></div>
        </div>
        <a class="fiestas-plan-community-link" href="/planes/">
          <i class="fa-solid fa-people-group" aria-hidden="true"></i>
          <span>Planes vecinales</span>
        </a>
      </div>
    </header>

    <section class="fiestas-plan-section" data-plan-section="saved" hidden>
      <div data-plan-saved-content></div>
    </section>

    <section class="fiestas-plan-section" data-plan-section="plan">
      <form class="fiestas-plan-create-form" data-plan-create-form>
        <label for="plan-create-input">Crear un plan nuevo</label>
        <div>
          <input id="plan-create-input" type="text" maxlength="80" placeholder="Ej. Sábado en familia" data-plan-create-input />
          <button class="fiestas-plan-action fiestas-plan-action-primary" type="submit">Crear plan</button>
        </div>
        <fieldset class="fiestas-plan-icon-picker">
          <legend>Elige un icono</legend>
          <div data-plan-create-icons data-plan-icon-picker="create"></div>
        </fieldset>
      </form>
      <div data-plan-list hidden></div>
      <div class="fiestas-plan-detail" data-plan-section="detail" hidden data-plan-detail></div>
    </section>

    <div class="fiestas-plan-feedback" data-plan-feedback aria-live="polite" hidden></div>
    <div class="fiestas-plan-delete-dialog" data-plan-delete-confirm hidden>
      <button class="fiestas-plan-delete-dialog-backdrop" type="button" data-plan-delete-confirm-cancel aria-label="Cerrar diálogo"></button>
      <section class="fiestas-plan-delete-dialog-panel" role="dialog" aria-modal="true" aria-labelledby="plan-delete-confirm-title" aria-describedby="plan-delete-confirm-copy">
        <p class="fiestas-plan-kicker">GESTIONAR PLAN</p>
        <h2 class="fiestas-plan-delete-confirm-title" id="plan-delete-confirm-title">¿Eliminar este plan?</h2>
        <p id="plan-delete-confirm-copy">Se borrará <strong data-plan-delete-confirm-name></strong> de este navegador.</p>
        <div class="fiestas-plan-delete-confirm-actions">
          <button class="fiestas-plan-action" type="button" data-plan-delete-confirm-cancel>Cancelar</button>
          <button class="fiestas-plan-action fiestas-plan-action-danger" type="button" data-plan-delete-confirm-accept>Eliminar plan</button>
        </div>
      </section>
    </div>
    <div class="fiestas-plan-editor" data-plan-editor hidden>
      <button class="fiestas-plan-editor-backdrop" type="button" data-plan-editor-close aria-label="Cerrar edición"></button>
      <form class="fiestas-plan-editor-panel" data-plan-editor-form role="dialog" aria-modal="true" aria-labelledby="plan-editor-title">
        <div class="fiestas-plan-editor-head">
          <div>
            <p class="fiestas-plan-kicker">PERSONALIZA TU PLAN</p>
            <h2 id="plan-editor-title">Editar plan</h2>
          </div>
          <button class="fiestas-plan-editor-close" type="button" data-plan-editor-close aria-label="Cerrar edición">
            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
          </button>
        </div>
        <label class="fiestas-plan-editor-name">
          <span>Nombre del plan</span>
          <input type="text" maxlength="80" data-plan-editor-name />
        </label>
        <fieldset class="fiestas-plan-icon-picker">
          <legend>Elige un icono</legend>
          <div data-plan-editor-icons data-plan-icon-picker="edit"></div>
        </fieldset>
        <div class="fiestas-plan-editor-actions">
          <button class="fiestas-plan-action" type="button" data-plan-editor-close>Cancelar</button>
          <button class="fiestas-plan-action fiestas-plan-action-primary" type="submit">Guardar cambios</button>
        </div>
      </form>
    </div>
    <a class="fiestas-plan-import-link" data-plan-import-link href="/plan/importar/" hidden>Importar un plan compartido</a>
  </section>

</main>

<nav class="fiestas-bottom-nav" aria-label="Navegación de fiestas">
  <a class="fiestas-bottom-link" href="/">
    <i class="fa-regular fa-calendar" aria-hidden="true"></i>
    <span>Agenda</span>
  </a>
  <a class="fiestas-bottom-link" href="/mapa/">
    <svg class="fiestas-bottom-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M12 21s7-5.1 7-11a7 7 0 1 0-14 0c0 5.9 7 11 7 11Z" />
      <circle cx="12" cy="10" r="2.35" />
    </svg>
    <span>Mapa</span>
  </a>
  <a class="fiestas-bottom-link is-active" href="/plan/" aria-current="page">
    <i class="fa-regular fa-heart" aria-hidden="true"></i>
    <span>Mi plan</span>
  </a>
  <button class="fiestas-bottom-link" type="button" data-menu-open aria-label="Abrir más opciones">
    <i class="fa-solid fa-ellipsis" aria-hidden="true"></i>
    <span>Más</span>
    <span class="fiestas-hint-dot" data-menu-hint-dot hidden aria-hidden="true"></span>
  </button>
</nav>

{% include "partials/event-options.njk" %}
{% include "partials/plan-selector.njk" %}
{% include "partials/menu-drawer.njk" %}
{% include "partials/subscribe-modal.njk" %}

<div class="fiestas-plan-share-dialog" data-plan-share-dialog hidden>
  <button class="fiestas-plan-share-dialog-backdrop" type="button" data-plan-share-close aria-label="Cerrar diálogo"></button>
  <section class="fiestas-plan-share-dialog-panel" role="dialog" aria-modal="true" aria-labelledby="plan-share-dialog-title">
    <header class="fiestas-plan-share-dialog-head">
      <div>
        <p class="fiestas-plan-kicker">COMPARTIR PLAN</p>
        <h2 id="plan-share-dialog-title">Comparte tu plan</h2>
      </div>
      <button class="fiestas-plan-share-dialog-close" type="button" data-plan-share-close aria-label="Cerrar diálogo">
        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
      </button>
    </header>

    <ol class="fiestas-plan-share-steps">
      <li>
        <span>1</span>
        <p>Se generará un enlace con el plan <strong data-plan-share-name>tu plan</strong>.</p>
      </li>
      <li>
        <span>2</span>
        <p>Quien abra el enlace verá una vista previa antes de importarlo.</p>
      </li>
    </ol>

    <label class="fiestas-plan-share-message-label">
      <span>Mensaje para compartir</span>
      <textarea data-plan-share-message rows="5" readonly></textarea>
    </label>
    <p class="fiestas-plan-share-feedback" data-plan-share-feedback aria-live="polite" hidden></p>
    <div class="fiestas-plan-share-dialog-actions">
      <button class="fiestas-plan-action fiestas-plan-share-native" type="button" data-plan-share-native>
        <i class="fa-solid fa-arrow-up-from-bracket" aria-hidden="true"></i>
        <span>Compartir enlace</span>
      </button>
      <button class="fiestas-plan-action fiestas-plan-share-copy" type="button" data-plan-share-copy>
        <i class="fa-regular fa-copy" aria-hidden="true"></i>
        <span>Copiar mensaje</span>
      </button>
    </div>
  </section>
</div>
{% endblock %}
