{% extends "layout.njk" %}

{% block bodyClass %}fiestas-page fiestas-plan-page{% endblock %}
{% block footerClass %} site-footer--fiestas{% endblock %}

{% block body %}
<main class="fiestas-app fiestas-plan-app" data-fiestas-plans-page data-plan-import-url="{{ publicBaseUrl }}/plan/importar/">
  <script>
    window.__FIESTAS_2026_EVENTS__ = {{ fiestasEventsJson | safe }};
  </script>
  <section class="fiestas-plan-screen">
    <header class="fiestas-plan-page-head">
      <div class="fiestas-plan-topbar">
        <a class="fiestas-plan-logo" href="/" aria-label="Volver a la agenda">
          <img src="/assets/favicon.png" alt="" />
        </a>
        <h1>Mi plan</h1>
        <button class="fiestas-plan-header-share" type="button" data-plan-header-share aria-label="Compartir mi plan">
          <i class="fa-solid fa-arrow-up-from-bracket" aria-hidden="true"></i>
        </button>
      </div>
      <label class="fiestas-plan-picker">
        <i class="fa-solid fa-star" aria-hidden="true"></i>
        <span class="sr-only">Seleccionar plan</span>
        <select data-plan-picker aria-label="Seleccionar plan"></select>
        <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
      </label>
    </header>

    <section class="fiestas-plan-section" data-plan-section="saved" hidden>
      <div data-plan-saved-content></div>
    </section>

    <section class="fiestas-plan-section" data-plan-section="plan">
      <form class="fiestas-plan-create-form" data-plan-create-form>
        <label for="plan-create-input">Crear un plan nuevo</label>
        <div>
          <input id="plan-create-input" type="text" maxlength="80" placeholder="Ej. Sábado en familia" data-plan-create-input />
          <button class="fiestas-plan-action fiestas-plan-action-primary" type="submit">Crear plan</button>
        </div>
      </form>
      <div data-plan-list hidden></div>
      <div class="fiestas-plan-detail" data-plan-section="detail" hidden data-plan-detail></div>
    </section>

    <div class="fiestas-plan-feedback" data-plan-feedback aria-live="polite" hidden></div>
    <a class="fiestas-plan-import-link" data-plan-import-link href="/plan/importar/" hidden>Importar un plan compartido</a>
  </section>

</main>

<nav class="fiestas-bottom-nav" aria-label="Navegación de fiestas">
  <a class="fiestas-bottom-link" href="/">
    <i class="fa-regular fa-calendar" aria-hidden="true"></i>
    <span>Agenda</span>
  </a>
  <a class="fiestas-bottom-link" href="/mapa/">
    <svg class="fiestas-bottom-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M12 21s7-5.1 7-11a7 7 0 1 0-14 0c0 5.9 7 11 7 11Z" />
      <circle cx="12" cy="10" r="2.35" />
    </svg>
    <span>Mapa</span>
  </a>
  <a class="fiestas-bottom-link is-active" href="/plan/" aria-current="page">
    <i class="fa-regular fa-heart" aria-hidden="true"></i>
    <span>Mi plan</span>
  </a>
  <button class="fiestas-bottom-link" type="button" data-menu-open aria-label="Abrir más opciones">
    <i class="fa-solid fa-ellipsis" aria-hidden="true"></i>
    <span>Más</span>
    <span class="fiestas-hint-dot" data-menu-hint-dot hidden aria-hidden="true"></span>
  </button>
</nav>

{% include "partials/event-options.njk" %}
{% include "partials/plan-selector.njk" %}
{% include "partials/menu-drawer.njk" %}
{% include "partials/subscribe-modal.njk" %}
{% include "partials/location-modal.njk" %}

<div class="fiestas-plan-share-dialog" data-plan-share-dialog hidden>
  <button class="fiestas-plan-share-dialog-backdrop" type="button" data-plan-share-close aria-label="Cerrar diálogo"></button>
  <section class="fiestas-plan-share-dialog-panel" role="dialog" aria-modal="true" aria-labelledby="plan-share-dialog-title">
    <header class="fiestas-plan-share-dialog-head">
      <div>
        <p class="fiestas-plan-kicker">COMPARTIR PLAN</p>
        <h2 id="plan-share-dialog-title">Comparte tu plan</h2>
      </div>
      <button class="fiestas-plan-share-dialog-close" type="button" data-plan-share-close aria-label="Cerrar diálogo">
        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
      </button>
    </header>

    <ol class="fiestas-plan-share-steps">
      <li>
        <span>1</span>
        <p>Se va a descargar un archivo con este plan llamado <strong data-plan-share-name>tu plan</strong>.</p>
      </li>
      <li>
        <span>2</span>
        <p>Puedes compartir este archivo con cualquier persona por WhatsApp, Telegram, etcétera.</p>
      </li>
      <li>
        <span>3</span>
        <p>Copia este texto y mándales el archivo para que lo puedan importar a sus planes.</p>
      </li>
    </ol>

    <label class="fiestas-plan-share-message-label">
      <span>Mensaje para compartir</span>
      <textarea data-plan-share-message rows="5" readonly></textarea>
    </label>
    <p class="fiestas-plan-share-feedback" data-plan-share-feedback aria-live="polite" hidden></p>
    <div class="fiestas-plan-share-dialog-actions">
      <button class="fiestas-plan-action fiestas-plan-share-copy" type="button" data-plan-share-copy>
        <i class="fa-regular fa-copy" aria-hidden="true"></i>
        <span>Copiar mensaje</span>
      </button>
      <button class="fiestas-plan-action fiestas-plan-share-download" type="button" data-plan-share-download>
        <i class="fa-solid fa-download" aria-hidden="true"></i>
        <span>Descargar el plan</span>
      </button>
    </div>
  </section>
</div>
{% endblock %}
