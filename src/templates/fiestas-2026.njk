{% extends "layout.njk" %}

{% block bodyClass %}fiestas-page{% if mapPage %} fiestas-map-page{% endif %}{% endblock %}

{# El CSS de Leaflet se inyecta bajo demanda desde ensureLeaflet() al abrir el mapa. #}

{% block footerClass %} site-footer--fiestas{% endblock %}

{% block body %}
<main class="fiestas-app" data-fiestas-app data-community-plans-href="/planes/">
  <div class="fiestas-scroll-header" data-fiestas-scroll-header aria-hidden="true" inert>
    <button class="fiestas-scroll-brand" type="button" data-fiestas-scroll-top aria-label="Volver arriba" title="Volver arriba">
      <img src="/assets/favicon-64.png" alt="" aria-hidden="true" />
    </button>
    <span class="fiestas-scroll-day" data-fiestas-scroll-day aria-live="polite">Agenda de fiestas</span>
    <div class="fiestas-scroll-actions">
      <button class="fiestas-scroll-action" type="button" data-fiestas-share-site aria-label="Compartir Fiestas Valladolid 2026" title="Compartir Fiestas Valladolid 2026">
        <i class="fa-solid fa-share-nodes" aria-hidden="true"></i>
      </button>
      <button class="fiestas-scroll-action" type="button" data-fiestas-scroll-search aria-label="Abrir buscador" title="Abrir buscador">
        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
      </button>
    </div>
  </div>
  <section class="fiestas-screen">
    <header class="fiestas-hero" aria-labelledby="fiestas-title">
      <img class="fiestas-hero-fireworks" src="/assets/hero-fireworks.webp" alt="" aria-hidden="true" width="320" height="213" fetchpriority="high" />
      <div class="fiestas-hero-top">
        <a class="fiestas-brand" href="/" aria-label="Portada de Fiestas 2026">
          <img src="/assets/favicon-64.png" alt="" />
          <span id="fiestas-title" class="fiestas-title">Fiestas 2026</span>
        </a>
        <div class="fiestas-hero-actions">
          <button class="fiestas-share-toggle" type="button" data-fiestas-share-site aria-label="Compartir Fiestas Valladolid 2026" title="Compartir Fiestas Valladolid 2026">
            <i class="fa-solid fa-share-nodes" aria-hidden="true"></i>
          </button>
          <button class="fiestas-search-toggle" type="button" data-fiestas-search-toggle aria-expanded="false" aria-controls="fiestas-search-panel" aria-label="Abrir buscador">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
          </button>
        </div>
      </div>
      <div class="fiestas-hero-copy">
        <p class="fiestas-hero-credit">
          <span>Creado por</span>
          <a class="fiestas-hero-subtitle" href="https://aldeapucela.org" target="_blank" rel="noopener noreferrer">Aldea Pucela</a>
        </p>
        <p class="fiestas-intro">Valladolid · 4-13 septiembre</p>
        <p class="fiestas-share-feedback" data-fiestas-share-feedback role="status" aria-live="polite" hidden></p>
      </div>
    </header>

    <section class="fiestas-date-panel" id="fiestas-date-panel" aria-label="Selector de fechas">
      <div class="fiestas-date-carousel" data-fiestas-date-carousel>
        <button class="fiestas-date-nav fiestas-date-nav-prev" type="button" data-fiestas-date-prev aria-label="Ver días anteriores" aria-controls="fiestas-dates" hidden>
          <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
        </button>
        <nav class="fiestas-date-strip" id="fiestas-dates" data-fiestas-dates>
        <button class="fiestas-date-card is-active" type="button" data-date="all" aria-pressed="true">
          <span>Todos</span>
          <strong>Días</strong>
          <small>4-13 SEP</small>
        </button>
        {% for day in fiestasDates %}
        <button class="fiestas-date-card" type="button" data-date="{{ day.date }}" aria-pressed="false">
          <span>{{ day.weekday }}</span>
          <strong>{{ day.dayNumber }}</strong>
          <small>{{ day.monthLabel }}</small>
        </button>
        {% endfor %}
        </nav>
        <button class="fiestas-date-nav fiestas-date-nav-next" type="button" data-fiestas-date-next aria-label="Ver días siguientes" aria-controls="fiestas-dates" hidden>
          <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
        </button>
      </div>
    </section>

    <section class="fiestas-filter-region" data-fiestas-filter-region aria-labelledby="fiestas-filter-region-title">
      <div class="fiestas-map-filter-header">
        <div>
          <span class="fiestas-map-filter-kicker">Explora el mapa</span>
          <h2 id="fiestas-filter-region-title">Filtros</h2>
        </div>
        <button class="fiestas-map-filter-close" type="button" data-fiestas-map-filter-close aria-label="Cerrar filtros">
          <i class="fa-solid fa-xmark" aria-hidden="true"></i>
        </button>
      </div>

      <section class="fiestas-search-panel" id="fiestas-search-panel" data-fiestas-search-panel hidden>
        <label class="fiestas-search">
          <span class="sr-only">Buscar actividades</span>
          <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
          <input type="search" data-fiestas-search placeholder="Buscar actividad, lugar o barrio" autocomplete="off" />
        </label>
      </section>

      <section class="fiestas-controls" aria-label="Filtros">
        <div class="fiestas-filter-row" data-fiestas-filter-panel>
        <div class="fiestas-type-menu">
          <button class="fiestas-type-menu-button" type="button" data-fiestas-areas-toggle aria-expanded="false">
            <svg class="fiestas-filter-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M12 21s7-5.1 7-11a7 7 0 1 0-14 0c0 5.9 7 11 7 11Z" />
              <circle cx="12" cy="10" r="2.35" />
            </svg>
            <span data-fiestas-areas-label>Zonas</span>
          </button>
          <div class="fiestas-type-list" data-fiestas-areas hidden>
            <div class="fiestas-type-options">
              {% for area in fiestasAreas %}
              <label class="fiestas-type-option">
                <input type="checkbox" value="{{ area }}" data-area="{{ area }}" />
                <span>{{ area }}</span>
              </label>
              {% endfor %}
            </div>
            <button class="fiestas-filter-accept" type="button" data-fiestas-filter-accept>
              <i class="fa-solid fa-check" aria-hidden="true"></i>
              <span>Aceptar</span>
            </button>
          </div>
        </div>
        <div class="fiestas-type-menu">
          <button class="fiestas-type-menu-button" type="button" data-fiestas-types-toggle aria-expanded="false">
            <svg class="fiestas-filter-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="m20 13.5-6.5 6.5a2 2 0 0 1-2.83 0L4 13.33V4h9.33L20 10.67a2 2 0 0 1 0 2.83Z" />
              <circle cx="8.5" cy="8.5" r="1.1" />
            </svg>
            <span data-fiestas-types-label>Tipos</span>
          </button>
          <div class="fiestas-type-list" data-fiestas-types hidden>
            <div class="fiestas-type-options">
              {% for type in fiestasTypes %}
              <label class="fiestas-type-option">
                <input type="checkbox" value="{{ type }}" data-type="{{ type }}" />
                <span>{{ type }}</span>
              </label>
              {% endfor %}
            </div>
            <button class="fiestas-filter-accept" type="button" data-fiestas-filter-accept>
              <i class="fa-solid fa-check" aria-hidden="true"></i>
              <span>Aceptar</span>
            </button>
          </div>
        </div>
        <div class="fiestas-type-menu">
          <button class="fiestas-type-menu-button" type="button" data-fiestas-tickets-toggle aria-expanded="false">
            <svg class="fiestas-filter-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M4 7.5A2.5 2.5 0 0 0 4 12a2.5 2.5 0 0 0 0 4.5V18h16v-1.5a2.5 2.5 0 0 0 0-4.5 2.5 2.5 0 0 0 0-4.5V6H4v1.5Z" />
              <path d="M12 6v12" stroke-dasharray="1.5 1.5" />
            </svg>
            <span data-fiestas-tickets-label>Precio</span>
          </button>
          <div class="fiestas-type-list" data-fiestas-tickets hidden>
            <div class="fiestas-type-options">
              <label class="fiestas-type-option">
                <input type="checkbox" value="free" data-ticket-kind="free" />
                <span>Gratis</span>
              </label>
              <label class="fiestas-type-option">
                <input type="checkbox" value="paid" data-ticket-kind="paid" />
                <span>Pago</span>
              </label>
              <label class="fiestas-type-option">
                <input type="checkbox" value="registration" data-ticket-kind="registration" />
                <span>Inscripción</span>
              </label>
            </div>
            <button class="fiestas-filter-accept" type="button" data-fiestas-filter-accept>
              <i class="fa-solid fa-check" aria-hidden="true"></i>
              <span>Aceptar</span>
            </button>
          </div>
        </div>
        <button class="fiestas-favorite-filter" type="button" data-fiestas-favorites-filter aria-pressed="false">
          <i class="fa-regular fa-bookmark" aria-hidden="true"></i>
          <span class="sr-only">Guardados</span>
        </button>
      </div>
      <div class="fiestas-filter-summary" data-fiestas-filter-summary hidden>
        <div class="fiestas-filter-summary-row">
          <div class="fiestas-active-filters" data-fiestas-active-filters></div>
          <button class="fiestas-clear-filter" type="button" data-fiestas-clear-filters hidden>
            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
            <span>Limpiar filtros</span>
          </button>
        </div>
        <span class="fiestas-filter-count" data-fiestas-filter-count aria-live="polite"></span>
      </div>
      </section>
    </section>

    <section class="fiestas-agenda is-loading" data-fiestas-agenda aria-label="Agenda de fiestas">
      <div class="fiestas-empty">Cargando agenda...</div>
    </section>

    {% include "partials/map-shell.njk" %}

    <a class="fiestas-plan-card" href="/plan/">
      <img class="fiestas-plan-icon" src="/assets/plan-confetti.webp" alt="" aria-hidden="true" loading="lazy" />
      <span>
        <strong>Vive las Fiestas</strong>
        <small>Guarda actividades y prepara tu plan.</small>
      </span>
      <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
    </a>
  </section>

</main>

<nav class="fiestas-bottom-nav" aria-label="Navegación de fiestas">
  <button class="fiestas-bottom-link is-active" type="button" data-view-tab="agenda" aria-pressed="true">
    <i class="fa-regular fa-calendar" aria-hidden="true"></i>
    <span>Agenda</span>
  </button>
  <button class="fiestas-bottom-link" type="button" data-view-tab="map" aria-pressed="false">
    <svg class="fiestas-bottom-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M12 21s7-5.1 7-11a7 7 0 1 0-14 0c0 5.9 7 11 7 11Z" />
      <circle cx="12" cy="10" r="2.35" />
    </svg>
    <span>Mapa</span>
  </button>
  <a class="fiestas-bottom-link" href="/plan/">
    <i class="fa-regular fa-heart" aria-hidden="true"></i>
    <span>Mi plan</span>
  </a>
  <a class="fiestas-bottom-link" href="/casetas/">
    <i class="fa-solid fa-store" aria-hidden="true"></i>
    <span>Casetas</span>
  </a>
  <button class="fiestas-bottom-link" type="button" data-menu-open aria-label="Abrir más opciones">
    <i class="fa-solid fa-ellipsis" aria-hidden="true"></i>
    <span>Más</span>
    <span class="fiestas-hint-dot" data-menu-hint-dot hidden aria-hidden="true"></span>
  </button>
</nav>

{% include "partials/menu-drawer.njk" %}
{% include "partials/event-options.njk" %}
{% include "partials/plan-selector.njk" %}
{% include "partials/subscribe-modal.njk" %}
{% endblock %}
