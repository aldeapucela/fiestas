{% extends "layout.njk" %}

{% block bodyClass %}fiestas-page fiestas-community-plans-page{% endblock %}
{% block footerClass %} site-footer--fiestas{% endblock %}

{% block body %}
<main class="fiestas-app fiestas-plan-app fiestas-community-plans-app" data-community-plans-page data-community-plans-url="{{ communityPlansUrl }}">
  <script>
    window.__FIESTAS_2026_EVENTS__ = {{ fiestasEventsJson | safe }};
  </script>

  <section class="fiestas-plan-screen fiestas-community-plans-screen">
    <header class="fiestas-plan-page-head">
      <div class="fiestas-plan-topbar">
        <a class="fiestas-plan-logo" href="/plan/" aria-label="Volver a Mi plan">
          <img src="/assets/favicon.png" alt="" />
        </a>
        <h1>Planes vecinales</h1>
        <span class="fiestas-plan-header-share" aria-hidden="true"></span>
      </div>
      <a class="fiestas-plan-import-back" href="/plan/">
        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
        <span>Volver a Mi plan</span>
      </a>
    </header>

    <section class="fiestas-community-plans-intro" aria-labelledby="community-plans-title">
      <p class="fiestas-plan-kicker">COLECCIONES DE LA COMUNIDAD</p>
      <h2 id="community-plans-title">Planes vecinales</h2>
      <p>Planes creados por vecinos y editores para disfrutar las fiestas a tu manera.</p>
    </section>

    <section class="fiestas-community-plans-catalog" data-community-plans-catalog aria-live="polite" aria-busy="true">
      <div class="fiestas-community-plans-loading" data-community-plans-loading>
        <i class="fa-solid fa-spinner" aria-hidden="true"></i>
        <p>Buscando planes publicados…</p>
      </div>
    </section>
  </section>
</main>

<nav class="fiestas-bottom-nav" aria-label="Navegación de fiestas">
  <a class="fiestas-bottom-link" href="/">
    <i class="fa-regular fa-calendar" aria-hidden="true"></i>
    <span>Agenda</span>
  </a>
  <a class="fiestas-bottom-link" href="/mapa/">
    <svg class="fiestas-bottom-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M12 21s7-5.1 7-11a7 7 0 1 0-14 0c0 5.9 7 11 7 11Z" />
      <circle cx="12" cy="10" r="2.35" />
    </svg>
    <span>Mapa</span>
  </a>
  <a class="fiestas-bottom-link is-active" href="/plan/" aria-current="page">
    <i class="fa-regular fa-heart" aria-hidden="true"></i>
    <span>Mi plan</span>
  </a>
  <button class="fiestas-bottom-link" type="button" data-menu-open aria-label="Abrir más opciones">
    <i class="fa-solid fa-ellipsis" aria-hidden="true"></i>
    <span>Más</span>
    <span class="fiestas-hint-dot" data-menu-hint-dot hidden aria-hidden="true"></span>
  </button>
</nav>

{% include "partials/menu-drawer.njk" %}
{% include "partials/subscribe-modal.njk" %}
{% include "partials/location-modal.njk" %}
{% endblock %}
