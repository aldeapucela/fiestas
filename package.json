{
  "name": "fiestas-valladolid",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "test:e2e": "playwright test",
    "prepare": "git config core.hooksPath scripts/hooks",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "events:import:ferias": "node scripts/import-eventos-ferias.mjs",
    "events:normalize": "node scripts/normalize-event-text.mjs && node scripts/normalize-event-data.mjs",
    "events:audit:history": "node scripts/audit-event-history.mjs",
    "events:registry:migrate": "node scripts/migrate-event-import-registry.mjs",
    "clean": "node -e \"import('node:fs/promises').then(fs=>fs.rm('dist',{recursive:true,force:true}))\"",
    "icons": "node scripts/build-icons.mjs",
    "images:link": "node scripts/link-event-images.mjs --write",
    "locations:audit": "node scripts/enrich-event-locations.mjs --dry-run",
    "casetas:locations": "node scripts/enrich-caseta-locations.mjs",
    "casetas:qr": "node scripts/generate-caseta-qr.mjs",
    "social:plan": "node scripts/generate-community-plan-social.mjs",
    "social:daily": "node scripts/generate-daily-popular.mjs",
    "screenshots": "node scripts/capture-readme-screenshots.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.28.2",
    "fontawesome-subset": "^4.6.0",
    "leaflet": "^1.9.4",
    "nunjucks": "^3.2.4",
    "postcss": "^8.5.26",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.17"
  }
}
